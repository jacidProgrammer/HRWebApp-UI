# Copy to .env and adjust. Values below match the HRWebApp docker-compose setup.
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8082
VITE_KEYCLOAK_REALM=hr-realm
VITE_KEYCLOAK_CLIENT_ID=hr-api-login

# Demo mode: a role picker instead of Keycloak and an in-browser mock API. `npm run dev:mock` turns it on;
# never set this for a real deployment.
# VITE_AUTH_MODE=mock
